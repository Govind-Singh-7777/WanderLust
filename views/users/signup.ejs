<% layout("layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp On WanderLust</h1>
    <div class="col-6 offset-3">
        <form method="post" action="/signup" class="needs-validation" novalidate>
            <div>
                <label for="username" class="form-label">Username</label>
                <input type="text" placeholder="Enter Name" name="username" id="username" class="form-control" required>
                <div class="invalid-feedback">Username Required</div>
            </div>
            <div>
                <label for="email" class="form-label">Email</label>
                <input type="text" placeholder="Enter Name" name="email" id="email" class="form-control" required>
                <div class="invalid-feedback">Email Required</div>
            </div>
            <div>
                <label for="password" class="form-label">Password</label>
                <input type="password" placeholder="Enter Name" name="password" id="password" class="form-control" required>
                <div class="invalid-feedback">Password Required</div>
            </div>
            <br>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>