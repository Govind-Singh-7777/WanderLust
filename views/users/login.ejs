<% layout("layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-3">Login</h1>
    <div class="col-6 offset-3">
        <form method="post" action="/login" class="needs-validation" novalidate>
            <div>
                <label for="username" class="form-label">Username</label>
                <input type="text" placeholder="Enter Name" name="username" id="username" class="form-control" required>
            </div>
            <div>
                <label for="password" class="form-label">Password</label>
                <input type="password" placeholder="Enter Name" name="password" id="password" class="form-control" required>
            </div>
            <br>
            <button class="btn btn-success">Login</button>
        </form>
    </div>
</div>