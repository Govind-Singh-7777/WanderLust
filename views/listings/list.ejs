
<% layout("/layouts/boilerplate") %>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
    </script>
    <h3>List Detail</h3>
    <div class="row">
        <div class="col-md-8 offset-2">
            <div class="listing-card">
                <img src="<%= list.image.url %>" class="card-img-top show-img" alt="...">
                <div class="card-body">
                    <h5>Name: <%= list.title %></h5>
                    <h5>Owned by: <%= list.owner.username %></h5>
                    <h6>About: <%=list.description%></h6>
                    <h6>Price: &#8377;<%=list.price.toLocaleString("en-IN")%>/night</h6>
                    <h6>Location: <%=list.location%></h6>
                    <h6>Country: <%=list.country%></h6>
                </div>
            </div>
            <% if(currUser && currUser._id.equals(list.owner._id)) { %>
                <div class="show-btn">
                    <form method="get" action="/listings/<%=list._id%>/edit">
                    <button class="btn btn-dark">Edit</button>
                    </form>
                    <br>
                    <form method="post" action="/listings/<%=list._id%>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            <% } %>
            <% if(currUser) { %>
                <div class="mb-3 mt-3">
                    <hr>
                    <h4>Leave A Review</h4>
                    <form method="post" action="/listings/<%=list._id%>/reviews" novalidate class="needs-validation">
                        <label for="rating" class="form-label"><b>Rating</b></label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        <div>
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                            <div class="invalid-feedback">Comment Required</div>
                        </div>
                        <button class="btn btn-outline-dark mt-3">Submit</button>
                    </form>
                </div>
            <% } %>
            <hr>
            <% if(list.reviews.length > 0){%>
                <div class="mb-3 mt-3">
                    <h4>All Reviews</h4>
                    <div class="row">
                        <%for(let rev of list.reviews){%>
                            <div class="card col-6">
                                <div class="card-body">
                                    <h5 class="card-title">@<%=rev.author.username%></h5>
                                    <p class="starability-result" data-rating="<%=rev.rating%>">
                                    </p>
                                    <p class="card-text"><%=rev.comment%></p>
                                </div>
                                <% if(currUser && currUser._id.equals(rev.author._id)) { %>
                                    <form class="mb-2" method="post" action="/listings/<%=list._id%>/reviews/<%=rev._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-dark">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        <%}%>
                    </div>
                </div>
            <%}%>   
            <div>
                <h3>Where you'll be</h3>
                <div id="map"></div>
                <script src="/js/map.js"></script>
            </div>
        </div>
    </div>