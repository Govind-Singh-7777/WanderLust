<% layout("layouts/boilerplate") %>

    <h3>Edit Your List</h3>
    <br>
    <form method="post" action="/listings/<%=newList._id%>?_method=put" novalidate class="needs-validation" enctype="multipart/form-data">

            <div>
                <label for="title" class="form-label">Title</label>
                <input type="text"  name="listing[title]" class="form-control" required value="<%=newList.title%> ">
            </div>
            <div>
                <label for="description" class="form-label">Description</label>
                <textarea type="text" name="listing[description]" class="form-control" id="" required><%=newList.description%></textarea>
            </div>
            <div>
                <br>
                <h6>Original Image</h6>
                <img src="<%= imgUrl %>" alt="">
                <br>
                <label for="image" class="form-label">Upload New Image</label>
                <input type="file" name="listing[image]" id="" class="form-control">
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" id="" value="<%=newList.price%>" class="form-control" required>
                </div>
                <div class="col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" id="" value="<%=newList.country%>" class="form-control" required>
                </div>
            </div>
            
            <div>
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" id="" value="<%=newList.location%>" class="form-control" required>
            </div>

            <br>
            <button class="btn btn-dark">Submit</button>
            <br>
            <br>
    </form>
