<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br>
        <h3>Create New Listing</h3>
        <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <div>
                <label for="listing[title]" class="form-label">Title</label>
                <input type="text" placeholder="Enter Name" name="listing[title]" class="form-control" required>
                <div class="invalid-feedback">Title Required</div>
            </div>
            <div>
                <label for="listing[description]" class="form-label">Description</label>
                <textarea name="listing[description]" placeholder="Enter Description" class="form-control" id="" required></textarea>
               <div class="invalid-feedback">Description Required</div>
            </div>
            <div>
                <label for="listing[image]" class="form-label">Upload Listing Image</label>
                <input type="file" name="listing[image]" id="" class="form-control" required>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label for="listing[price]" class="form-label">Price</label>
                    <input type="number" name="listing[price]" placeholder="Enter Price" id="" class="form-control" required>
                    <div class="invalid-feedback">Price Required</div>
                </div>
                <div class="col-md-8">
                    <label for="listing[country]" class="form-label">Country</label>
                    <input type="text" placeholder="Enter Country" name="listing[country]" id="" class="form-control" required>
                    <div class="invalid-feedback">Country Required</div>
                </div>
            </div>
            
            <div>
                <label for="listing[location]" class="form-label">Location</label>
                <input type="text" placeholder="Enter Location" name="listing[location]" id="" class="form-control" required>
                <div class="invalid-feedback">Location Required</div>
            </div>

            <br>
            <button class="btn btn-dark">Submit</button>
            <br>
            <br>
        </form>
    </div>
</div>
    